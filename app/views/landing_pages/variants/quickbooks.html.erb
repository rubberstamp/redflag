<% content_for :layout_override do %>
<style>
  /* Hide all navigation elements */
  nav.bg-[#005C88], 
  nav.bg-slate-800 {
    display: none !important;
  }
  
  /* Remove padding from main content */
  main .mx-auto.max-w-7xl {
    padding-top: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: none !important;
  }
  
  /* Extra space to ensure nav is fully hidden */
  header, .navbar-container {
    display: none !important;  
  }
</style>
<% end %>

<div class="min-h-screen bg-gray-50">
  <!-- Hero Section - QuickBooks Users Focus -->
  <div class="bg-gradient-to-r from-blue-800 to-blue-700 text-white py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="md:w-1/2 mb-10 md:mb-0">
          <div class="mb-3">
            <span class="bg-green-500 text-blue-900 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide">QuickBooks Users</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Enhance Your QuickBooks With Fraud Detection</h1>
          <p class="text-xl md:text-2xl mb-6 text-gray-200">Seamless integration for powerful transaction analysis</p>
          <p class="text-lg mb-8 text-gray-300">Add fraud detection capabilities to your QuickBooks setup with just a few clicks. No data exports required.</p>
          
          <!-- Initial Email Capture Form -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden w-full md:max-w-md mb-4">
            <div class="px-6 py-4">
              <h3 class="text-lg font-semibold text-gray-800 mb-2">Connect Your QuickBooks</h3>
              <p class="text-sm text-gray-600 mb-4">Enter your email to get started with our QuickBooks integration.</p>
              
              <%= render 'leads/initial_capture' %>
            </div>
          </div>
          
          <div class="flex items-center mt-6 text-gray-200">
