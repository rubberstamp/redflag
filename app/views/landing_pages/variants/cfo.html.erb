<% content_for :layout_override do %>
<style>
  /* Hide all navigation elements */
  nav.bg-[#005C88], 
  nav.bg-slate-800 {
    display: none !important;
  }
  
  /* Remove padding from main content */
  main .mx-auto.max-w-7xl {
    padding-top: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: none !important;
  }
  
  /* Extra space to ensure nav is fully hidden */
  header, .navbar-container {
    display: none !important;  
  }
</style>
<% end %>

<div class="min-h-screen bg-gray-50">
  <!-- Hero Section - CFO Focused -->
  <div class="bg-gradient-to-r from-indigo-900 to-indigo-800 text-white py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="flex flex-col md:flex-row items-center justify-between">
        <div class="md:w-1/2 mb-10 md:mb-0">
          <div class="mb-3">
            <span class="bg-red-600 bg-opacity-80 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide">For CFOs & Financial Leaders</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Gain Financial Control & Reduce Waste</h1>
          <p class="text-xl md:text-2xl mb-6 text-gray-200">AI-powered analysis that catches what manual audits miss</p>
          <p class="text-lg mb-8 text-gray-300">Protect your company assets with our financial transaction monitoring system built for CFOs and financial controllers.</p>
          
          <!-- Initial Email Capture Form -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden w-full md:max-w-md mb-4">
            <div class="px-6 py-4">
              <h3 class="text-lg font-semibold text-gray-800 mb-2">Request Your Financial Risk Assessment</h3>
              <p class="text-sm text-gray-600 mb-4">Receive a personalized financial control gap analysis.</p>
              
              <%= render 'leads/initial_capture' %>
            </div>
          </div>
        </div>
        <div class="md:w-1/2 flex justify-center">
          <div class="relative w-full max-w-md">
            <div class="absolute -top-6 -right-6 bg-yellow-400 text-indigo-900 text-sm font-bold px-4 py-1 rounded-full shadow-lg transform rotate-3 z-10">
              CFO Dashboard
            </div>
            <div class="bg-white rounded-xl shadow-2xl overflow-hidden">
              <div class="p-6 bg-gradient-to-br from-indigo-700 to-indigo-800 text-white">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-xl font-semibold">Financial Risk Scorecard</h3>
                  <span class="px-3 py-1 bg-red-600 bg-opacity-80 rounded-full text-sm">Executive View</span>
                </div>
                <div class="bg-indigo-600 bg-opacity-50 rounded-lg p-4 mb-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="text-gray-200">Financial Control Rating</span>
                    <span class="font-bold text-xl">B+</span>
                  </div>
                  <div class="w-full bg-indigo-500 rounded-full h-2">
                    <div class="bg-yellow-400 h-2 rounded-full" style="width: 70%"></div>
                  </div>
                </div>
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <span>Policy Compliance</span>
                    <span class="font-semibold">85%</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span>Control Coverage</span>
                    <span class="font-semibold">73%</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span>Anomaly Detection</span>
                    <span class="font-semibold">Active</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Trust Indicators - CFO Focused -->
  <div class="border-b border-gray-200">
    <div class="container mx-auto px-6 py-6 max-w-5xl">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-gray-800">SOC 2</span>
          <span class="text-sm text-gray-600">Compliant</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-gray-800">GDPR</span>
          <span class="text-sm text-gray-600">Compliant</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-gray-800">256-bit</span>
          <span class="text-sm text-gray-600">Encryption</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-bold text-gray-800">99.9%</span>
          <span class="text-sm text-gray-600">Uptime</span>
        </div>
      </div>
    </div>
  </div>

